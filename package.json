{
 "name": "multibrowser",
 "version": "0.1.0",
 "description": "MultiBrowser: браузер с несколькими аккаунтами",
 "main": "main.js",
 "scripts": {
  "start": "electron .",
  "dist": "electron-builder --win nsis --publish never"
 },
 "devDependencies": {
  "electron": "33.2.1",
  "electron-builder": "25.1.8"
 },
 "build": {
  "appId": "app.multibrowser",
  "productName": "MultiBrowser",
  "files": [
   "main.js",
   "preload.js",
   "ui/**"
  ],
  "extraResources": [
   {
    "from": "resources",
    "to": "."
   }
  ],
  "win": {
   "target": "nsis",
   "icon": "build/icon.ico"
  },
  "nsis": {
   "oneClick": true,
   "perMachine": false,
   "installerIcon": "build/icon.ico",
   "uninstallerIcon": "build/icon.ico",
   "installerHeaderIcon": "build/icon.ico",
   "shortcutName": "MultiBrowser",
   "createDesktopShortcut": true,
   "createStartMenuShortcut": true,
   "runAfterFinish": true,
   "language": "1049"
  },
  "publish": {
   "provider": "github",
   "releaseType": "release"
  }
 },
 "author": "MultiBrowser",
 "dependencies": {
  "electron-updater": "6.3.9"
 }
}