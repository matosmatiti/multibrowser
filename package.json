{
 "name": "multibrowser",
 "version": "0.1.0",
 "description": "MultiBrowser",
 "main": "main.js",
 "scripts": {
  "start": "electron .",
  "dist": "electron-builder --win nsis --publish never"
 },
 "devDependencies": {
  "electron": "33.2.1",
  "electron-builder": "25.1.8"
 },
 "build": {
  "appId": "app.multibrowser",
  "productName": "MultiBrowser",
  "files": [
   "main.js",
   "preload.js",
   "ui/**"
  ],
  "extraResources": [
   {
    "from": "resources",
    "to": "."
   }
  ],
  "win": {
   "target": "nsis"
  },
  "nsis": {
   "oneClick": false,
   "allowToChangeInstallationDirectory": true
  }
 },
 "author": "MultiBrowser"
}